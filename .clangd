CompileFlags:
  Add:
    - -I./application
    - -I./application/typedef
    - -I./application/robot_cmd
    - -I./application/dart
    - -I./bsp/boards
    - -I./components/algorithm
    - -I./components/controller
    - -I./components/devices
    - -I./components/support
    - -I./Inc
    - -I./Drivers/CMSIS/Include
    - -I./Drivers/CMSIS/Device/ST/STM32F4xx/Include
    - -I./Drivers/STM32F4xx_HAL_Driver/Inc
    - -I./Middlewares/Third_Party/FreeRTOS/Source/include
    - -I./Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS
    - -I./Middlewares/Third_Party/FreeRTOS/Source/portable/RVDS/ARM_CM4F
    - -I./Middlewares/ST/STM32_USB_Device_Library/Core/Inc
    - -I./Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Inc
    - -DUSE_HAL_DRIVER
    - -DSTM32F407xx
    - -DARM_MATH_CM4
    - -D__FPU_PRESENT=1
    - -target
    - arm-none-eabi
    - -mcpu=cortex-m4
    - -mthumb
    - -mfpu=fpv4-sp-d16
    - -mfloat-abi=hard
  Remove:
    - -W*
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

